{
  "name": "sagacity-syndicate",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6 <23"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "npm run check:public-artifacts && vitest run",
    "check:public-artifacts": "node scripts/check-public-artifacts.mjs",
    "check:public-candidate": "node scripts/check-public-artifacts.mjs --public-candidate",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:public-candidate && npm audit --audit-level=high"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "express": "^5.3.0",
    "openai": "^7.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.5",
    "jsdom": "^27.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "body-parser": "^2.4.0"
  }
}

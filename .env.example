OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_COUNCIL_MODEL=gpt-6-astra
OPENAI_SYNTHESIS_MODEL=gpt-6-astra
PORT=8787
MOCK_COUNCIL=true

# Foundry council (explicit opt-in; set MOCK_COUNCIL=false)
COUNCIL_PROVIDER=openai
FOUNDRY_OPENAI_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_COUNCIL_DEPLOYMENT=
FOUNDRY_SYNTHESIS_DEPLOYMENT=

# Foundry Voice Live WebRTC relay (no permanent key in browser)
VOICE_PROVIDER=openai
FOUNDRY_VOICE_ENDPOINT=
FOUNDRY_VOICE_MODEL=gpt-realtime
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
HOST=127.0.0.1

# Hosted App Service only, behind platform Easy Auth
REQUIRE_OWNER_AUTH=false
OWNER_PRINCIPAL_ID=
LOG_DIRECTORY=
